// SafetyOS persistence layer.
//
// Status/category/type fields are kept as plain String columns, not Postgres
// enums — every one of them is already validated against a hand-written
// allow-list in each module's schema.ts on the way in, so a DB-level enum
// would just duplicate that check while making the allowed values harder to
// change. Wire-format fields (dates, nested JSON snapshots) are shaped to
// match the existing TypeScript interfaces exactly, so the service layer is
// the only thing that needs to change — routes, controllers, validation, and
// the entire client are unaffected by this migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The session store (server/src/app.ts's `connect-pg-simple`) creates and owns this table
// directly at runtime (`createTableIfMissing: true`) — it has never been part of Prisma's
// schema or migration history. Declared here, `@@ignore`d, purely so `prisma migrate diff`/
// `prisma migrate dev` stop proposing to DROP it as "not in the desired schema" the moment
// any other model changes: this is a documented Prisma pattern for a table another tool
// legitimately owns in the same database. Prisma Client never reads or writes this model
// (`@@ignore` excludes it from the generated Client entirely) and no application code
// should ever reference it — `connect-pg-simple` remains its only owner.
model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@ignore
}

// ---------------------------------------------------------------------------
// Reference-number counters (HZ-####, FND-####, CA-####, RA-####, INS-YYYY-####)
// ---------------------------------------------------------------------------
// One atomic upsert per counter instead of an in-memory variable — an in-memory
// counter resets to its starting value on every restart and would immediately
// collide with reference numbers already in the database.

model Counter {
  name  String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Organisations (Phase A — multi-organisation expand migration)
// ---------------------------------------------------------------------------
// New in this migration. Every relation pointing AT this model from an existing table
// (Workplace.organisationId, User.organisationId, InspectionTemplate.organisationId) is
// added nullable — see each model's own comment for why. This table itself starts empty;
// rows are populated by Phase A2's backfill, never by this migration.
//
// No delete endpoint/cascade is intended to ever exist for this model ("Organisation
// deletion will NOT be supported" — every FK pointing here uses onDelete: Restrict, so the
// database itself refuses to let an Organisation row be removed while anything still
// references it). Deliberately no @@unique on `name`: this migration does not yet know
// whether existing `Workplace.organisation` free-text values collide or need de-duplication
// (that inventory is Phase A2's job — see server/prisma's Phase A2 human-review step), so
// asserting uniqueness here now would be a premature, undecided product policy, not a
// safety requirement — same reasoning as deferring Workplace's own
// @@unique([organisationId, name]) below.
model Organisation {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workplaces          Workplace[]
  users               User[]
  inspectionTemplates InspectionTemplate[]
  invites             Invite[]

  @@index([status])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  // LEGACY, still authoritative for every workplace-scoping check in the running
  // application during Phase A — do not stop reading/writing this field. `workplaceRef`
  // below is the new relational pointer, added nullable and currently unused by any
  // controller/service.
  workplace    String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Phase A additions — both nullable, both unread/unwritten by application code this
  // phase. organisationId has no name collision with an existing column, so the relation
  // field is simply `organisation`. workplaceId's relation field is named `workplaceRef`
  // (not `workplace`) purely to avoid colliding with the legacy `workplace: String` column
  // above — expected to be renamed once that legacy column is dropped in the eventual
  // contract phase, not before.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  workplaceId    String?
  workplaceRef   Workplace?    @relation("UserWorkplace", fields: [workplaceId], references: [id], onDelete: Restrict)

  notifications NotificationEvent[]
  // Assignment-foundation relations (Phase A) — see each domain model's assignedToUserId
  // comment. Every one of these arrays is empty until a later phase starts writing to the
  // corresponding FK; nothing populates them in Phase A.
  assignedHazards           HazardReport[]     @relation("HazardAssignee")
  assignedFindings          Finding[]          @relation("FindingAssignee")
  assignedCorrectiveActions CorrectiveAction[] @relation("CorrectiveActionAssignee")

  @@index([organisationId])
  @@index([workplaceId])
}

// ---------------------------------------------------------------------------
// Invites (Phase A — structural only; see server/prisma's Phase C plan)
// ---------------------------------------------------------------------------
// No endpoint, service, or frontend reads/writes this table yet — it exists purely so
// Phase C does not need its own schema migration. `token` is the eventual single-use
// accept-invite credential; `invitedByUserId` is kept as a plain audit-identity string
// (matching the existing `actor`/`author`/`createdBy` convention on every activity-entry
// table in this schema) rather than a formal FK, since Phase A's brief only calls for
// Organisation/Workplace relations here.
model Invite {
  id              String    @id @default(uuid())
  token           String    @unique
  email           String
  role            String
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  workplaceId     String?
  workplace       Workplace?   @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  // Plain audit-identity string (matches the existing actor/author/createdBy convention on
  // every activity-entry table in this schema), not a formal FK — Phase A's approved brief
  // only calls for Organisation/Workplace relations on this model.
  invitedByUserId String
  status          String
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  acceptedAt      DateTime?

  @@index([organisationId])
  @@index([workplaceId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Workplaces (Organisation -> Workplace -> Area -> Location)
// ---------------------------------------------------------------------------

model Workplace {
  id           String   @id @default(uuid())
  // LEGACY, still authoritative for every organisation-scoping comparison in the running
  // application during Phase A — do not stop reading/writing this field.
  organisation String
  name         String
  code         String
  industry     String
  address      String
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Phase A addition — nullable (every existing row has no Organisation to point to until
  // Phase A2's backfill runs), unread/unwritten by application code this phase. Named
  // `organisationRef`, not `organisation`, purely to avoid colliding with the legacy free-text
  // column above — expected to be renamed once that legacy column is dropped later.
  organisationId String?
  organisationRef Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  areas        Area[]
  activity     WorkplaceActivityEntry[]

  // Phase A back-relations for the new workplaceId FKs added to these models — every array
  // is empty until a later phase's backfill populates the corresponding column.
  users              User[]              @relation("UserWorkplace")
  hazardReports      HazardReport[]
  incidents          Incident[]
  inspections        Inspection[]
  findings           Finding[]
  correctiveActions  CorrectiveAction[]
  riskAssessments    RiskAssessment[]
  notificationEvents NotificationEvent[]
  invites            Invite[]

  @@index([organisationId])
  // Deliberately NOT added yet: @@unique([organisationId, name]). Every existing row has
  // organisationId = null right now, so Postgres would technically accept this constraint
  // today (NULLs are never considered equal in a unique index) — but adding it now buys
  // nothing and creates a real risk later: if Phase A2's backfill finds two genuinely
  // duplicate (organisation, name) pairs in the existing free-text data, an early constraint
  // would turn that into a failed UPDATE mid-backfill instead of a finding in A2's human-
  // review inventory report, where it belongs. Add this constraint in A2, immediately after
  // the duplicate-workplace-name gate confirms zero conflicts — not before.
}

model WorkplaceActivityEntry {
  id          String    @id @default(uuid())
  workplaceId String
  workplace   Workplace @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  type        String
  message     String
  actor       String
  createdAt   DateTime

  @@index([workplaceId])
}

model Area {
  id          String     @id @default(uuid())
  workplaceId String
  workplace   Workplace  @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  name        String
  description String
  order       Int
  locations   Location[]

  @@index([workplaceId])
}

model Location {
  id          String @id @default(uuid())
  areaId      String
  area        Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name        String
  description String
  order       Int

  @@index([areaId])
}

// ---------------------------------------------------------------------------
// Hazard Reports
// ---------------------------------------------------------------------------

model HazardReport {
  id                   String   @id @default(uuid())
  referenceNumber      String   @unique
  title                String
  description          String
  reportType           String
  hazardCategory       String
  // LEGACY, still authoritative for every workplace-scoping check in the running
  // application during Phase A.
  workplace            String
  department           String
  location             String
  peopleAtRisk         String
  immediateActionTaken String
  riskLevel            String
  status               String
  reportedBy           String
  // LEGACY, still authoritative for assignment/notification routing during Phase A.
  assignedTo           String
  reportedAt           DateTime
  updatedAt            DateTime

  // Phase A additions — both nullable, both unread/unwritten by application code this
  // phase. See Workplace model comment (naming) and Assignment-foundation comment on User.
  workplaceId    String?
  workplaceRef   Workplace? @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  assignedToUserId String?
  assignedToUser   User?    @relation("HazardAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  activity          HazardActivityEntry[]
  comments          HazardComment[]
  evidence          HazardEvidenceItem[]
  findings          Finding[]
  correctiveActions CorrectiveAction[]
  riskAssessments   RiskAssessment[]
  incidents         Incident[]

  @@index([workplaceId])
  @@index([assignedToUserId])
}

model HazardActivityEntry {
  id        String       @id @default(uuid())
  hazardId  String
  hazard    HazardReport @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actor     String
  createdAt DateTime

  @@index([hazardId])
}

model HazardComment {
  id        String       @id @default(uuid())
  hazardId  String
  hazard    HazardReport @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  author    String
  message   String
  createdAt DateTime

  @@index([hazardId])
}

model HazardEvidenceItem {
  id         String       @id @default(uuid())
  hazardId   String
  hazard     HazardReport @relation(fields: [hazardId], references: [id], onDelete: Cascade)
  fileName   String
  fileSize   Int
  mimeType   String
  dataUrl    String       @db.Text
  uploadedBy String
  uploadedAt DateTime

  @@index([hazardId])
}

// ---------------------------------------------------------------------------
// Findings
// ---------------------------------------------------------------------------

model Finding {
  id                        String            @id @default(uuid())
  referenceNumber           String            @unique
  title                     String
  description               String
  // LEGACY, still authoritative for every workplace-scoping check in the running
  // application during Phase A.
  workplace                 String
  department                String
  location                  String
  riskLevel                 String
  status                    String
  hazardId                  String?
  hazardReferenceNumber     String?
  hazard                    HazardReport?     @relation(fields: [hazardId], references: [id], onDelete: SetNull)
  inspectionId              String?
  inspectionReferenceNumber String?
  inspection                Inspection?       @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  // The specific inspection response this finding was generated from, when applicable —
  // unique so the database itself guarantees at most one Finding per flagged response,
  // which is what actually prevents duplicate findings on a repeated/racing request
  // (see findings/service.ts#createFindingFromInspectionResponse), not just an app-level check.
  questionResponseId        String?           @unique
  questionResponse          QuestionResponse? @relation(fields: [questionResponseId], references: [id], onDelete: SetNull)
  createdBy                 String
  // LEGACY, still authoritative for assignment/notification routing during Phase A.
  assignedTo                String
  dueDate                   DateTime
  createdAt                 DateTime
  updatedAt                 DateTime

  // Phase A additions — both nullable, both unread/unwritten by application code this phase.
  workplaceId      String?
  workplaceRef     Workplace? @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  assignedToUserId String?
  assignedToUser   User?      @relation("FindingAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  activity          FindingActivityEntry[]
  comments          FindingComment[]
  correctiveActions CorrectiveAction[]

  @@index([hazardId])
  @@index([inspectionId])
  @@index([workplaceId])
  @@index([assignedToUserId])
}

model FindingActivityEntry {
  id        String   @id @default(uuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actor     String
  createdAt DateTime

  @@index([findingId])
}

model FindingComment {
  id        String   @id @default(uuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  author    String
  message   String
  createdAt DateTime

  @@index([findingId])
}

// ---------------------------------------------------------------------------
// Inspection Templates
// ---------------------------------------------------------------------------

model InspectionTemplate {
  id                   String   @id @default(uuid())
  name                 String
  code                 String
  description          String
  category             String
  applicableIndustries String[]
  version              Int
  status               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Phase A addition — nullable, unread/unwritten by application code this phase. Templates
  // are fully global (organisation-unaware) until whichever later phase decides and
  // implements per-organisation template visibility — this column only stages the FK for
  // that decision, it does not change today's "every template visible to everyone" behaviour.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  sections TemplateSection[]
  activity InspectionTemplateActivityEntry[]

  @@index([organisationId])
}

model InspectionTemplateActivityEntry {
  id                   String             @id @default(uuid())
  inspectionTemplateId String
  inspectionTemplate   InspectionTemplate @relation(fields: [inspectionTemplateId], references: [id], onDelete: Cascade)
  type                 String
  message              String
  actor                String
  createdAt            DateTime

  @@index([inspectionTemplateId])
}

model TemplateSection {
  id          String             @id @default(uuid())
  templateId  String
  template    InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int

  questions TemplateQuestion[]

  @@index([templateId])
}

model TemplateQuestion {
  id                   String          @id @default(uuid())
  sectionId            String
  section              TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text                 String
  guidance             String
  referenceNote        String
  responseType         String
  options              String[]
  required             Boolean
  evidenceRequired     Boolean
  allowFindingCreation Boolean
  order                Int

  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// Inspections
// ---------------------------------------------------------------------------

model Inspection {
  id                   String    @id @default(uuid())
  referenceNumber      String    @unique
  title                String
  status               String
  templateId           String
  templateName         String
  templateVersion      Int
  // Point-in-time copy of the template as it existed when the inspection was
  // created — deliberately denormalized (same as the in-memory version), so
  // later edits to the live template never change a past inspection.
  templateSnapshot     Json
  // LEGACY free-text fields, both still authoritative during Phase A. `organisation` here
  // has never been a security boundary (see server/prisma's Phase A audit note — it's
  // client-supplied display metadata, not validated against Workplace.organisation), and
  // stays exactly that way in this phase; only `workplace` gets a new relational pointer
  // below, per the approved architecture (organisation is derived through Workplace, never
  // stored a second time on a domain record).
  organisation         String
  workplace            String
  area                 String
  specificLocation     String
  inspectionDate       DateTime
  leadInspector        String
  additionalInspectors String[]
  purpose              String
  scope                String
  createdAt            DateTime
  updatedAt            DateTime
  submittedAt          DateTime?
  reviewedAt           DateTime?

  // Phase A addition — nullable, unread/unwritten by application code this phase.
  workplaceId  String?
  workplaceRef Workplace? @relation(fields: [workplaceId], references: [id], onDelete: Restrict)

  responses         QuestionResponse[]
  activity          InspectionActivityEntry[]
  findings          Finding[]
  correctiveActions CorrectiveAction[]

  @@index([workplaceId])
}

model QuestionResponse {
  id               String     @id @default(uuid())
  inspectionId     String
  inspection       Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  questionId       String
  sectionId        String
  responseType     String
  value            String     @db.Text
  notes            String     @db.Text
  evidenceNote     String
  // { id, title, description, riskLevel, recommendation, immediateAction, status } | null
  potentialFinding Json?
  answeredAt       DateTime

  // Reverse side of Finding.questionResponseId — no fields/references here, the FK lives
  // on Finding since a response can produce at most one finding, not the other way round.
  finding Finding?

  @@unique([inspectionId, questionId])
  @@index([inspectionId])
}

model InspectionActivityEntry {
  id           String     @id @default(uuid())
  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  type         String
  message      String
  actor        String
  createdAt    DateTime

  @@index([inspectionId])
}

// ---------------------------------------------------------------------------
// Corrective Actions
// ---------------------------------------------------------------------------

model CorrectiveAction {
  id                            String          @id @default(uuid())
  referenceNumber               String          @unique
  title                         String
  description                   String
  // LEGACY, still authoritative for every workplace-scoping check in the running
  // application during Phase A.
  workplace                     String
  department                    String
  location                      String
  priority                      String
  status                        String
  sourceType                    String
  // Exactly one of findingId/hazardId/inspectionId/riskAssessmentId may be set (enforced
  // in correctiveActions/schema.ts + service.ts) — a corrective action has one origin,
  // and a chain like Inspection -> Finding is resolved by following findingId ->
  // Finding.inspectionId rather than duplicating the pointer here.
  findingId                     String?
  findingReferenceNumber        String?
  finding                       Finding?        @relation(fields: [findingId], references: [id], onDelete: SetNull)
  hazardId                      String?
  hazardReferenceNumber         String?
  hazard                        HazardReport?   @relation(fields: [hazardId], references: [id], onDelete: SetNull)
  inspectionId                  String?
  inspectionReferenceNumber     String?
  inspection                    Inspection?     @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  riskAssessmentId              String?
  riskAssessmentReferenceNumber String?
  riskAssessment                RiskAssessment? @relation(fields: [riskAssessmentId], references: [id], onDelete: SetNull)
  incidentId                    String?
  incidentReferenceNumber       String?
  incident                      Incident?       @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  externalSourceReference       String?
  createdBy                     String
  // LEGACY, still authoritative for assignment/notification routing during Phase A.
  assignedTo                    String
  dueDate                       DateTime
  responseNote                  String
  respondedAt                   DateTime?
  evidenceNote                  String
  verifiedBy                    String
  verifiedAt                    DateTime?
  createdAt                     DateTime
  updatedAt                     DateTime
  closedAt                      DateTime?

  // Phase A additions — both nullable, both unread/unwritten by application code this phase.
  workplaceId      String?
  workplaceRef     Workplace? @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  assignedToUserId String?
  assignedToUser   User?      @relation("CorrectiveActionAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  activity CorrectiveActionActivityEntry[]
  comments CorrectiveActionComment[]
  evidence CorrectiveActionEvidenceItem[]

  @@index([hazardId])
  @@index([findingId])
  @@index([inspectionId])
  @@index([riskAssessmentId])
  @@index([incidentId])
  @@index([workplaceId])
  @@index([assignedToUserId])
}

// ---------------------------------------------------------------------------
// Incidents / Near Misses (Phase 6)
// ---------------------------------------------------------------------------

model Incident {
  id                    String    @id @default(uuid())
  referenceNumber       String    @unique
  eventType             String
  category              String
  title                 String
  description           String
  // LEGACY, still authoritative for every workplace-scoping check in the running
  // application during Phase A.
  workplace             String
  department            String
  location              String
  eventDate             DateTime
  reportedBy            String
  reportedAt            DateTime
  peopleInvolved        String
  injuryOccurred        Boolean
  injurySeverity        String?
  immediateActionTaken  String
  actualSeverity        String
  potentialSeverity     String
  status                String
  leadInvestigator      String
  investigationSummary  String
  rootCause             String
  contributingFactors   String
  lessonsLearned        String
  hazardId              String?
  hazardReferenceNumber String?
  hazard                HazardReport? @relation(fields: [hazardId], references: [id], onDelete: SetNull)
  updatedAt             DateTime  @updatedAt

  // Phase A addition — nullable, unread/unwritten by application code this phase.
  workplaceId  String?
  workplaceRef Workplace? @relation(fields: [workplaceId], references: [id], onDelete: Restrict)

  activity          IncidentActivityEntry[]
  comments          IncidentComment[]
  evidence          IncidentEvidenceItem[]
  correctiveActions CorrectiveAction[]

  @@index([workplace])
  @@index([status])
  @@index([eventType])
  @@index([eventDate])
  @@index([leadInvestigator])
  @@index([potentialSeverity])
  @@index([hazardId])
  @@index([workplaceId])
}

model IncidentActivityEntry {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       String
  message    String
  actor      String
  createdAt  DateTime

  @@index([incidentId])
}

model IncidentComment {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author     String
  message    String
  createdAt  DateTime

  @@index([incidentId])
}

model IncidentEvidenceItem {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fileName   String
  fileSize   Int
  mimeType   String
  dataUrl    String   @db.Text
  uploadedBy String
  uploadedAt DateTime

  @@index([incidentId])
}

model CorrectiveActionActivityEntry {
  id                 String           @id @default(uuid())
  correctiveActionId String
  correctiveAction   CorrectiveAction @relation(fields: [correctiveActionId], references: [id], onDelete: Cascade)
  type               String
  message            String
  actor              String
  createdAt          DateTime

  @@index([correctiveActionId])
}

model CorrectiveActionComment {
  id                 String           @id @default(uuid())
  correctiveActionId String
  correctiveAction   CorrectiveAction @relation(fields: [correctiveActionId], references: [id], onDelete: Cascade)
  author             String
  message            String
  createdAt          DateTime

  @@index([correctiveActionId])
}

model CorrectiveActionEvidenceItem {
  id                 String           @id @default(uuid())
  correctiveActionId String
  correctiveAction   CorrectiveAction @relation(fields: [correctiveActionId], references: [id], onDelete: Cascade)
  fileName           String
  fileSize           Int
  mimeType           String
  dataUrl            String           @db.Text
  uploadedBy         String
  uploadedAt         DateTime

  @@index([correctiveActionId])
}

// ---------------------------------------------------------------------------
// Risk Assessments
// ---------------------------------------------------------------------------

model RiskAssessment {
  id                    String        @id @default(uuid())
  referenceNumber       String        @unique
  title                 String
  assessmentType        String
  description           String
  // LEGACY, still authoritative for every workplace-scoping check in the running
  // application during Phase A.
  workplace             String
  department            String
  location              String
  status                String
  // Optional — many risk assessments (routine, statutory, project-based) are proactive
  // and never originate from a hazard report.
  hazardId              String?
  hazardReferenceNumber String?
  hazard                HazardReport? @relation(fields: [hazardId], references: [id], onDelete: SetNull)
  assessedBy            String
  approvedBy            String
  assessmentDate        DateTime
  nextReviewDate        DateTime?
  createdAt             DateTime
  updatedAt             DateTime

  // Phase A addition — nullable, unread/unwritten by application code this phase.
  workplaceId  String?
  workplaceRef Workplace? @relation(fields: [workplaceId], references: [id], onDelete: Restrict)

  items             RiskAssessmentItem[]
  activity          RiskAssessmentActivityEntry[]
  correctiveActions CorrectiveAction[]

  @@index([hazardId])
  @@index([workplaceId])
}

model RiskAssessmentItem {
  id                 String         @id @default(uuid())
  riskAssessmentId   String
  riskAssessment     RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
  hazard             String         @db.Text
  whoMightBeHarmed   String
  existingControls   String
  likelihood         Int
  severity           Int
  riskScore          Int
  riskLevel          String
  additionalControls String
  residualLikelihood Int?
  residualSeverity   Int?
  residualRiskScore  Int?
  residualRiskLevel  String?
  order              Int

  @@index([riskAssessmentId])
}

model RiskAssessmentActivityEntry {
  id               String         @id @default(uuid())
  riskAssessmentId String
  riskAssessment   RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
  type             String
  message          String
  actor            String
  createdAt        DateTime

  @@index([riskAssessmentId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model NotificationEvent {
  id     String @id @default(uuid())
  type   String
  // Display-name snapshot, kept for backward compatibility with pre-Phase-3 rows and the
  // Admin "view another recipient's feed by name" override — recipientId is the real
  // authorization boundary going forward (see notifications/controller.ts#resolveRecipient).
  recipient   String
  recipientId String?
  recipientUser User? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  // Denormalized copy of the recipient's workplace at creation time — lets scheduled
  // reminders and admin/debug queries scope by site without joining through User. LEGACY,
  // still authoritative during Phase A; the new `workplaceId` below is a nullable, unread/
  // unwritten Phase A addition that will eventually replace this string, per the same
  // reasoning already applied to every other denormalized workplace pointer in this schema.
  workplace              String?
  workplaceId            String?
  workplaceRef           Workplace? @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  priority               String?
  subject                String
  message                String
  relatedEntityType      String
  relatedEntityId        String
  relatedEntityReference String
  // Set only on scheduler-generated due-soon/overdue reminders, as
  // `${type}:${relatedEntityId}:${recipientId}` — the unique constraint is what makes a
  // repeated scheduler run a no-op instead of creating duplicate reminders. Left null for
  // every event-driven notification (assignment, status change, etc.), which may legitimately
  // repeat over a record's lifetime.
  reminderKey String?   @unique
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([recipientId])
  @@index([workplace])
  @@index([workplaceId])
}
