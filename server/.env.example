PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://safetyos:safetyos@localhost:5433/safetyos
# Required in production — generate with: openssl rand -base64 32
SESSION_SECRET=
# Required for the scheduled reminder endpoint (POST /api/system/reminders/run) to accept
# requests — generate with: openssl rand -base64 32. Leave unset to disable the endpoint.
CRON_SECRET=

# Required to run `npm test`. Must point at a database that is NOT the one DATABASE_URL
# points at — a separate local Postgres database/container, or a separate Neon
# project/branch dedicated to testing. The test suite refuses to start (see test/env.ts)
# if this is unset or if it resolves to the same host+database as DATABASE_URL; it never
# falls back to DATABASE_URL. Set this in server/.env.test (gitignored, like .env) rather
# than here — do not put a real value in this example file.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
